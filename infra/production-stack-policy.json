{
  "Statement": [
    { "Effect": "Allow", "Action": "Update:*", "Principal": "*", "Resource": "*" },
    {
      "Effect": "Deny",
      "Action": ["Update:Replace", "Update:Delete"],
      "Principal": "*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ResourceType": [
            "AWS::EC2::Instance", "AWS::EC2::EIP", "AWS::EC2::EIPAssociation",
            "AWS::EC2::VPC", "AWS::EC2::Subnet", "AWS::EC2::SecurityGroup",
            "AWS::EC2::RouteTable", "AWS::EC2::Route", "AWS::EC2::InternetGateway",
            "AWS::EC2::VPCGatewayAttachment", "AWS::EC2::SubnetRouteTableAssociation",
            "AWS::IAM::Role", "AWS::IAM::InstanceProfile", "AWS::DynamoDB::Table"
          ]
        }
      }
    }
  ]
}
